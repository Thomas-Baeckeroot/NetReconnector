# Template for the Fritzbox TR-064 credentials used by fritz_dsl_stats.py.
#
# This is a gabarit only — never fill in real values here or commit this
# file with real values. On the NAS, copy the *content* below into a file
# OUTSIDE the git checkout (so a stray `git add -A` can never pick it up),
# e.g. /volume1/homes/Deimos-admin/.config/NetReconnector/fritzbox.env,
# then `chmod 600` it (owner-only — root still reads it fine, since root
# bypasses Unix file permissions).
#
# The FRITZ!Box user below must exist under
# FRITZ!Box > System > Utilisateurs de la FRITZ!Box, with "Accès pour les
# applis" (TR-064) enabled both globally (Réseau domestique > Réseau >
# Partages dans le réseau domestique) and for this user specifically.

FRITZ_USER=fritz8103
FRITZ_PASSWORD=changeme
